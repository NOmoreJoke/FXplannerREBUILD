# 跨服务共享本地环境变量
# 复制为 .env.local 后按需修改；实际配置禁止提交 Git。

# 服务端口
API_PORT=4001
WEB_PORT=3001

# 跨服务通信
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api

# 本地开发前端错误日志服务（packages/dev-log-server，仅 dev）
DEV_LOG_PORT=8787
NEXT_PUBLIC_DEV_LOG_URL=http://localhost:8787/frontend-log

# AI 助手多模型白名单（changes/ai-model-whitelist/技术方案.md §3.4/§5.3）
# 全部模型密钥未配时全部 AI 端点 503 AI_NOT_CONFIGURED（不影响其余功能启动）；
# 单个模型密钥未配时仅该模型请求 503，其余模型不受影响
# aigysd.com OpenAI 兼容网关（与 LingJi services/chat/.env.development 同源）
AI_PROVIDER_AIGYSD_API_KEY=
# 网关地址（留空走 OpenAI 官方默认端点）
AI_PROVIDER_AIGYSD_BASE_URL=
# claude-sonnet-4-6 专用密钥（网关透传，与主 key 不同）
AI_PROVIDER_AIGYSD_ANTHROPIC_API_KEY=
# gemini-3-flash-preview 专用密钥（网关透传，与主 key 不同）
AI_PROVIDER_AIGYSD_GEMINI_API_KEY=
# 默认聊天模型（必须是白名单成员，白名单见 services/chat/src/ai/ai-models.config.ts）
AI_DEFAULT_CHAT_MODEL=gpt-4.1-mini
# 总开关（false 一键关停整模块 → 503 AI_DISABLED）
AI_CHAT_ENABLED=true
# 上下文窗口条数（最近 N 条历史）
AI_CHAT_HISTORY_WINDOW=20
# 进程内流式并发上限（超 → 429 AI_BUSY）
AI_CHAT_MAX_CONCURRENCY=40
# 用户级日配额（超 → 429 AI_QUOTA_EXCEEDED；进程内计数，重启清零）
AI_DAILY_MESSAGE_QUOTA=100
# 仅 E2E：假流式模型不外呼（production 下开启将拒绝启动）
AI_E2E_FAKE_STREAM=false
# 假流式帧间隔（ms）
AI_E2E_FAKE_INTERVAL_MS=30
