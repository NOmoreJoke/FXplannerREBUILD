generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  passwordHash  String?       @map("password_hash")
  name          String?
  avatar        String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  otpIdentities OtpIdentity[]

  // M0 schema 冻结：以下为新增业务模型的反向关系（Prisma 关系必须双侧声明）
  userSettings    UserSettings?
  termsConsents   TermsConsent[]
  accounts        Account[]
  transactions    Transaction[]
  costLots        CostLot[]
  plans           Plan[]
  usageRecords    UsageRecord[]
  corrections     Correction[]
  reminders       Reminder[]
  dataRequests    DataRequest[]
  initialHoldings InitialHolding[]
  aiConversations AiConversation[]
  // ToB R1：组织成员身份与成员级提醒已读
  memberships     Membership[]
  reminderReads   ReminderRead[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// ToB R1 组织地基（技术方案 §5.1；MIG-A 增量迁移，见
// migrations/<ts>_tob_r1_mig_a_org_foundation）。
// Organization 不存 ownerId：所有权以 Membership 为唯一来源，
// 单活跃 Owner 不变量由 memberships_single_active_owner_uidx
// 部分唯一索引（WHERE role='OWNER' AND status='ACTIVE'）保护。
// ─────────────────────────────────────────────────────────────

/// 组织工作台（默认组织由 MIG-B 幂等回填创建）
model Organization {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  memberships Membership[]
  settings    OrganizationSettings?
  invitations OrganizationInvitation[]

  @@map("organizations")
}

/// 组织成员（移除 = DISABLED 保留历史归属；重新邀请事务内恢复）
model Membership {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  /// OWNER/ADMIN/FINANCE/OPERATOR/VIEWER（策略真源 = authorization/permission-policy）
  role           String
  /// ACTIVE/DISABLED；单活跃 Owner 由数据库部分唯一索引兜底
  status         String       @default("ACTIVE")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("memberships")
}

/// 组织邀请（tokenHash @unique：高熵 token 单向 SHA-256 落库，原始 token 只出现在邀请链接）
model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  email          String
  /// 单向 SHA-256 hash；原始 token 绝不落库、不进审计（W19 invitation-rules 强制）
  tokenHash      String       @unique @map("token_hash")
  /// ADMIN/FINANCE/OPERATOR/VIEWER（禁邀 OWNER 由 invitation-rules 强制）
  role           String
  /// 操作者快照语义：不做 User 外键级联，用户注销不追溯邀请行
  invitedById    String       @map("invited_by_id")
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  declinedAt     DateTime?    @map("declined_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@map("organization_invitations")
}

/// 组织级设置（本位币/准备偏好/提醒开关/记账起点；1:1，未建账组织无行）
model OrganizationSettings {
  id              String       @id @default(cuid())
  organizationId  String       @unique @map("organization_id")
  baseCurrency    String       @map("base_currency")
  prepPreference  String       @default("balanced") @map("prep_preference")
  reminderEnabled Boolean      @default(true) @map("reminder_enabled")
  ledgerStartedAt DateTime?    @map("ledger_started_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// 组织审计日志（只写只读：无 update/delete 接口；detail 白名单摘要，敏感字段由 audit-sanitizer 剥离）
/// organizationId 不做外键：审计保留策略独立于组织删除生命周期（技术方案 §5.1）
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// NULL = 系统动作
  actorUserId    String?  @map("actor_user_id")
  /// USER / API / AGENT
  actorType      String   @map("actor_type")
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  /// SUCCESS / DENIED / FAILED
  result         String
  requestId      String?  @map("request_id")
  agentRunId     String?  @map("agent_run_id")
  detail         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// 成员级提醒已读（LEDGER-03：一名成员已读不清除他人未读；MIG-B 回填存量 Reminder.readAt）
model ReminderRead {
  id         String   @id @default(cuid())
  reminderId String   @map("reminder_id")
  userId     String   @map("user_id")
  readAt     DateTime @default(now()) @map("read_at") @db.Timestamptz(3)
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, userId])
  @@map("reminder_reads")
}

model ExchangeRate {
  id                String    @id @default(cuid())
  base              String
  quote             String
  rate              Decimal   @db.Decimal(20, 10)
  /// 现汇卖出价（1 外币单位 = X 本位币；仅 abc 源填充，百外币单位已换算）；NULL = 该源无卖出价，录入场景回退 rate
  sellRate          Decimal?  @db.Decimal(20, 10) @map("sell_rate")
  source            String
  observedAt        DateTime  @map("observed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  /// 仅最新取价成功时写入；历史和无法确认来源的存量行保持 NULL。
  latestConfirmedAt DateTime? @map("latest_confirmed_at")
  /// 当前行版本的缓存迁移归属，普通更新会清除此标记。
  migrationOwnerId String? @db.Uuid @map("migration_owner_id")
  /// 每次按「1 外币 = X 本位币」回源写入的新标记。既有行默认无标记。
  canonicalWriteId String? @db.Uuid @map("canonical_write_id")

  @@unique([base, quote, observedAt])
  @@index([base, quote, observedAt])
  @@map("exchange_rates")
}

model RateCacheMigrationReceipt {
  id            String    @id @db.Uuid
  scopeChecksum String    @map("scope_checksum")
  appliedAt     DateTime  @default(now()) @map("applied_at")
  rolledBackAt  DateTime? @map("rolled_back_at")

  @@map("rate_cache_migration_receipts")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  channel    String
  target     String
  /// 验证码用途（account-data 技术方案 §3.4）：登录/导出/清空/注销分别验证，互相不能顶用
  purpose    String    @default("LOGIN")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  requestIp  String?   @map("request_ip")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([channel, target, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model OtpIdentity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  channel   String
  target    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, target])
  @@index([userId])
  @@map("otp_identities")
}

model WorkflowCheckpoint {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.VarChar(255)
  threadId       String   @map("thread_id") @db.VarChar(255)
  checkpoint     Json
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId], map: "idx_conversation_id")
  @@map("workflow_checkpoints")
}

// ─────────────────────────────────────────────────────────────
// M0 schema 一次冻结基线：以下 14 个模型自 W1 起只读，
// 后续新增表按 schema 冻结流程回主分支增建。
// 金额列统一 Decimal(20, 4)；汇率/单位成本统一 Decimal(20, 10)。
// ─────────────────────────────────────────────────────────────

/// 用户偏好设置（本位币、地区语言、准备偏好、账本起点；1:1）
model UserSettings {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  baseCurrency    String    @map("base_currency")
  locale          String
  region          String
  prepPreference  String    @default("balanced") @map("prep_preference")
  reminderEnabled Boolean   @default(true) @map("reminder_enabled")
  ledgerStartedAt DateTime? @map("ledger_started_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// 币种字典（seed 从 @fxplanner-new/money 的 CURRENCIES 生成，单一事实来源在 money 包）
model Currency {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  nameZh        String   @map("name_zh")
  nameEn        String   @map("name_en")
  decimalPlaces Int      @map("decimal_places")
  sortOrder     Int      @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("currencies")
}

/// 条款与 18 岁确认记录
model TermsConsent {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  termsVersion String   @map("terms_version")
  consentType  String   @map("consent_type")
  consentedAt  DateTime @map("consented_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, consentType])
  @@map("terms_consents")
}

/// 按币种虚拟账户（同币种单账户；余额 0 保留不删）
/// MIG-A：organizationId/createdById 增量可空；唯一约束仍为 (userId, currencyCode)，MIG-E 收紧时替换
model Account {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  /// ToB R1 租户列（可空 = 兼容存量个人行；MIG-B 回填后非空）
  organizationId String? @map("organization_id")
  /// 创建者审计快照（可空；成员移除/注销不级联删除组织账本）
  createdById   String?  @map("created_by_id")
  currencyCode  String   @map("currency_code")
  balance       Decimal  @default(0) @db.Decimal(20, 4)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currencyCode])
  @@index([organizationId, currencyCode])
  @@map("accounts")
}

/// 买入交易（feeAmount：null=未知，0=无；version 为更正版本号，从 1 递增）
model Transaction {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空；createdById 来源原 userId）
  organizationId  String?  @map("organization_id")
  createdById     String?  @map("created_by_id")
  currencyCode    String   @map("currency_code")
  quantity        Decimal  @db.Decimal(20, 4)
  principalAmount Decimal  @map("principal_amount") @db.Decimal(20, 4)
  feeAmount       Decimal? @map("fee_amount") @db.Decimal(20, 4)
  exchangeRate    Decimal  @map("exchange_rate") @db.Decimal(20, 10)
  rateSource      String   @map("rate_source")
  rateObservedAt  DateTime @map("rate_observed_at")
  planId          String?  @map("plan_id")
  transactedAt    DateTime @map("transacted_at")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, transactedAt])
  @@index([organizationId, transactedAt])
  @@map("transactions")
}

/// 初始持仓记录（onboarding-rework 技术方案 §3.2：每币种仅一笔；rate 采用价
/// 8 位小数，rawRate 为来源原值；CostLot.sourceId 指向本表，与 PURCHASE→Transaction 同构）
model InitialHolding {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空）
  organizationId String?  @map("organization_id")
  createdById    String?  @map("created_by_id")
  currencyCode   String   @map("currency_code")
  amount         Decimal  @db.Decimal(20, 4)
  rate           Decimal  @map("rate") @db.Decimal(20, 10)
  rawRate        Decimal  @map("raw_rate") @db.Decimal(20, 10)
  rateSource     String   @map("rate_source")
  rateObservedAt DateTime @map("rate_observed_at")
  cost           Decimal  @db.Decimal(20, 4)
  confirmedAt    DateTime @map("confirmed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currencyCode])
  @@index([organizationId, currencyCode])
  @@map("initial_holdings")
}

/// FIFO 成本批次（sourceType：INITIAL / PURCHASE；sourceId 指向来源记录）
model CostLot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空；必须随来源记录同组织，由 organization-scope 断言）
  organizationId String?  @map("organization_id")
  currencyCode   String   @map("currency_code")
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  quantity       Decimal  @db.Decimal(20, 4)
  remainingQty   Decimal  @map("remaining_qty") @db.Decimal(20, 4)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(20, 10)
  totalCost      Decimal  @map("total_cost") @db.Decimal(20, 4)
  acquiredAt     DateTime @map("acquired_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currencyCode, acquiredAt, createdAt])
  @@index([organizationId, currencyCode, acquiredAt])
  @@map("cost_lots")
}

/// 换汇计划（status：ACTIVE / COMPLETED / CANCELLED，CANCELLED 为终态）
model Plan {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空；createdById 来源原 userId）
  organizationId String?  @map("organization_id")
  createdById    String?  @map("created_by_id")
  name           String?  @map("name")
  pacePreference String   @default("balanced") @map("pace_preference")
  targetCurrency String   @map("target_currency")
  targetAmount   Decimal  @map("target_amount") @db.Decimal(20, 4)
  expectUseDate  DateTime @map("expect_use_date")
  prepLeadDays   Int      @default(3) @map("prep_lead_days")
  latestPrepDate DateTime @map("latest_prep_date")
  /// 开始准备日（M5 落库：M2 创建时只算不存；NULL = 未落基线，重建排期时回退「明天起首个工作日」）
  planStartDate  DateTime? @map("plan_start_date") @db.Timestamptz(3)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments   PlanInstallment[]
  changeLogs     PlanChangeLog[]

  @@index([userId, status])
  @@index([organizationId, status])
  @@map("plans")
}

/// 计划分批排期（一个计划固定 3 条；seq 为批次序号 1..3）
model PlanInstallment {
  id          String   @id @default(cuid())
  planId      String   @map("plan_id")
  seq         Int
  scheduledAt DateTime @map("scheduled_at")
  amount      Decimal  @db.Decimal(20, 4)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, seq])
  @@index([planId, scheduledAt])
  @@map("plan_installments")
}

/// 计划分配汇总（1:1 绑定计划；剩余 = amount − usedAmount，业务层计算，不存列）
model PlanAllocation {
  id         String   @id @default(cuid())
  planId     String   @unique @map("plan_id")
  amount     Decimal  @db.Decimal(20, 4)
  usedAmount Decimal  @map("used_amount") @db.Decimal(20, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("plan_allocations")
}

/// 计划变更记录（M5：目标/分配/完成/取消/重开留痕；完整变更明细由 JSON 快照承载）
/// 通过 plan 关系显式对齐 migration SQL 中已有的 REFERENCES plans(id) ON DELETE CASCADE（零 DDL 变更）
model PlanChangeLog {
  id             String   @id @default(cuid())
  planId         String   @map("plan_id")
  /// ToB R1 租户列（MIG-A 增量可空；回填按父 Plan.organizationId 校对，孤儿阻断）
  organizationId String?  @map("organization_id")
  /// 实际操作者（可空；成员移除/注销不丢历史）
  actorUserId    String?  @map("actor_user_id")
  /// 主类型用于筛选：TARGET_ADJUSTED | ALLOCATION_ADJUSTED | COMPLETED | CANCELLED | REOPENED
  changeType     String   @map("change_type")
  beforeTarget   Decimal  @map("before_target") @db.Decimal(20, 4)
  afterTarget    Decimal  @map("after_target") @db.Decimal(20, 4)
  beforeAlloc    Decimal  @map("before_alloc") @db.Decimal(20, 4)
  afterAlloc     Decimal  @map("after_alloc") @db.Decimal(20, 4)
  releasedAmount Decimal  @default(0) @map("released_amount") @db.Decimal(20, 4)
  beforeSnapshot Json     @map("before_snapshot")
  afterSnapshot  Json     @map("after_snapshot")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt(sort: Desc)])
  @@index([organizationId, planId, createdAt(sort: Desc)])
  @@map("plan_change_logs")
}

/// 资金使用记录（分次使用 = 多行；version 为更正版本号）
model UsageRecord {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空；createdById 来源原 userId）
  organizationId String?  @map("organization_id")
  createdById    String?  @map("created_by_id")
  planId         String   @map("plan_id")
  currencyCode   String   @map("currency_code")
  amount         Decimal  @db.Decimal(20, 4)
  usedAt         DateTime @map("used_at")
  /// 备注（M7 增量：可空，无默认值，兼容存量；≤ 200 字符由业务层校验）
  remark         String?
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([organizationId, usedAt])
  @@map("usage_records")
}

/// 使用分摊明细（一笔使用消耗多个成本批次）
model UsageLotAllocation {
  id        String   @id @default(cuid())
  usageId   String   @map("usage_id")
  lotId     String   @map("lot_id")
  quantity  Decimal  @db.Decimal(20, 4)
  cost      Decimal  @db.Decimal(20, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([usageId, lotId])
  @@map("usage_lot_allocations")
}

/// 更正历史（before/after 快照；FAILED 保留失败尝试与原因）
model Correction {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空；actorUserId = 历史操作者快照）
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  reason         String
  beforeSnapshot Json     @map("before_snapshot")
  afterSnapshot  Json     @map("after_snapshot")
  status         String   @default("APPLIED")
  failReason     String?  @map("fail_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([organizationId, targetType, targetId])
  @@map("corrections")
}

/// 站内提醒（同计划同日合并防打扰：userId + dedupKey + scheduledFor 唯一）
model Reminder {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  /// ToB R1 租户列（MIG-A 增量可空；业务事件随组织隔离）
  organizationId String?        @map("organization_id")
  type           String
  planId         String?        @map("plan_id")
  dedupKey       String         @map("dedup_key")
  scheduledFor   DateTime       @map("scheduled_for")
  /// 已读时间（M9：null = 未读；读时派生 matters，行仅承载「何时该提醒 + 是否已读」）
  /// MIG-B 后个人已读拆分至 ReminderRead（成员级），本列保留为存量个人读态回退
  readAt         DateTime?      @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  readStates     ReminderRead[]

  @@unique([userId, dedupKey, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([organizationId, scheduledFor])
  @@map("reminders")
}

/// 数据权利请求（type：EXPORT / CLEAR / DELETION）
model DataRequest {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  /// ToB R1（技术方案 §9）：PERSONAL / ORGANIZATION；MIG-B 映射 EXPORT/DELETION→PERSONAL、历史 CLEAR→默认组织
  scope             String    @default("PERSONAL")
  /// ToB R1 租户列（MIG-A 增量可空；仅 scope=ORGANIZATION 时填充）
  organizationId    String?   @map("organization_id")
  type              String
  status            String    @default("PENDING")
  requestedAt       DateTime  @map("requested_at")
  dueAt             DateTime  @map("due_at")
  downloadExpiresAt DateTime? @map("download_expires_at")
  fileUrl           String?   @map("file_url")
  /// 验证凭证一次性绑定（account-data 技术方案 §3.4）：指向已消费的 OtpChallenge，
  /// unique 保证「提交后本次验证立即失效」，重放被唯一约束拒绝
  verifiedChallengeId String?   @unique @map("verified_challenge_id")
  /// 终态时间戳（COMPLETED 完成时刻；读时推进/导出生成的审计与进度展示）
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 同时服务互斥查询、锁守卫查询与「查当前请求」，避免每请求多索引开销
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("data_requests")
}

/// AI 助手会话（ai-assistant 技术方案 §3.2；标题 = 首条消息前 20 字）
model AiConversation {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ToB R1 租户列（MIG-A 增量可空；查询按 (userId, organizationId) 严格隔离）
  organizationId String?  @map("organization_id")
  title          String
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  messages       AiMessage[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_user_updated")
  @@index([userId, organizationId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

/// AI 助手消息（role："user" | "assistant"；助手消息只在流式成功后落库，无 status 列）
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  /// assistant 消息所用的白名单 key（如 "gpt-4.1-mini"，ai-model-whitelist 技术方案 §3.2）；user 消息为 NULL，存量行为 NULL
  model          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId, createdAt], map: "idx_conversation_created")
  @@map("ai_messages")
}
