# Chat 后端专属本地环境变量
# 跨服务变量 API_PORT、CORS_ORIGIN 由根目录 .env.local 提供。

# OTP（生产按启用的 Channel 配置；未配置时对应请求会明确失败）
# 必填；必须与 JWT_SECRET 不同的独立 OTP_CODE_SECRET，用于验证码 HMAC。
OTP_CODE_SECRET=
# ── 邮件通道：阿里云邮件推送 DirectMail SMTP ──
# 在阿里云邮件推送控制台：创建发信域名（DNS 验证）→ 创建发信地址 → 获取 SMTP 密码
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=FXPlanner
# 邮件 mock（未接入真实邮件服务时本地联调）：true 强制 mock / false 强制走真实 SMTP；
# 留空时：非生产 && 未配置 SMTP_USER/SMTP_PASS → 自动 mock（验证码打服务端日志 + 响应带 devCode），生产永不 mock
#OTP_EMAIL_MOCK=
# 限流上限（次/分钟）：默认 auth 5、OTP 登录 10、全局 10；仅 E2E 等测试场景按需放大
# E2E 集中造数需放大 AUTH_THROTTLE_LIMIT（否则 api-seeder 批量注册会撞 429），
# 以 `dotenv -e .env.local` 方式启动后端生效（与 bun run dev 同链路）；
# 注意 vitest 单测/接口测试不读这里的放大值（vitest.config 已隔离，限流用例按代码常量断言）
#AUTH_THROTTLE_LIMIT=
#AUTH_OTP_THROTTLE_LIMIT=
#THROTTLE_GLOBAL_LIMIT=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/

# 本地 PostgreSQL（直接使用本机 5432 实例）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fxplanner_new_db_local?schema=public"

# 至少 32 字符；复制后请替换为随机值
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# 本地演示账号密码
SEED_DEMO_PASSWORD="demo123456"
