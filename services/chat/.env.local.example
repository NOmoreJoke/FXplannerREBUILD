# Chat 后端专属本地环境变量
# 跨服务变量 API_PORT、CORS_ORIGIN 由根目录 .env.local 提供。

# OTP（生产按启用的 Channel 配置；未配置时对应请求会明确失败）
# 必填；必须与 JWT_SECRET 不同的独立 OTP_CODE_SECRET，用于验证码 HMAC。
OTP_CODE_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_URL=https://api.resend.com/emails
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/

# 本地 PostgreSQL（直接使用本机 5432 实例）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fxplanner_new_db_local?schema=public"

# 至少 32 字符；复制后请替换为随机值
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# 本地演示账号密码
SEED_DEMO_PASSWORD="demo123456"
