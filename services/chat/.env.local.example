# Chat 后端专属本地环境变量
# 跨服务变量 API_PORT、CORS_ORIGIN 由根目录 .env.local 提供。

# 本地 PostgreSQL（infra/compose/compose.yaml 的 test-db）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fxplanner_new_test?schema=public"

# 至少 32 字符；复制后请替换为随机值
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# 本地演示账号密码
SEED_DEMO_PASSWORD="demo123456"
