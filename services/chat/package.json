{
  "name": "@fxplanner-new/chat",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nest start --watch 2>&1 | tee logs/dev.log",
    "build": "rm -rf dist tsconfig.tsbuildinfo && nest build",
    "start": "NODE_ENV=production bun run dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean:logs": "rm -rf logs/*.log",
    "db:up": "bash ../../scripts/db-local.sh up",
    "db:down": "bash ../../scripts/db-local.sh down",
    "db:status": "bash ../../scripts/db-local.sh status",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "backfill:cost-lots": "tsx src/account/backfill-cost-lots.script.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fxplanner-new/money": "workspace:*",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/openai": "^1.4.7",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.0.0",
    "@types/ali-oss": "^6.23.3",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "webpack": "^5.108.0"
  }
}
