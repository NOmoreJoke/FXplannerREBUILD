{
  "name": "@fxplanner-new/chat-web",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development next dev -p ${WEB_PORT:-3001}",
    "build": "next build",
    "start": "NODE_ENV=production next start -p ${WEB_PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "lint": "bun run ../../scripts/lint-observe.ts --dir clients/chat-web --enforce",
    "generate:api": "cd ../../services/chat && bunx tsx ../../scripts/export-openapi.ts && cd ../../clients/chat-web && openapi-typescript lib/api/openapi.json -o lib/api/schema.gen.ts && bun -e 'import fs from \"node:fs\"; const p = \"lib/api/schema.gen.ts\"; fs.writeFileSync(p, \"// 由 generate:api 自动生成（后端 DTO → OpenAPI → openapi-typescript），禁止手改；后端契约变更后重新执行 bun run generate:api。\\n\" + fs.readFileSync(p, \"utf8\"));'",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fxplanner-new/money": "workspace:*",
    "@sentry/browser": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "embla-carousel-react": "^8.6.0",
    "immer": "^11.1.11",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@fxplanner-new/typescript-config": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "code-inspector-plugin": "^1.6.6",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "react-hook-form": "^7.81.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.5"
  }
}