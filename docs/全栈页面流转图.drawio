        </mxCell>
        <mxCell id="p_login" value="&lt;b&gt;/login 登录页&lt;/b&gt;&lt;br&gt;邮箱＋验证码（OTP）&lt;br&gt;store: auth-store（token/用户态）&lt;br&gt;API: POST /api/auth/otp/send-code&lt;br&gt;POST /api/auth/otp/login · /api/auth/login&lt;br&gt;GET /api/auth/me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C98A2D;fontSize=11;align=left;spacing=8;arcSize=8;" vertex="1" parent="z_public">
