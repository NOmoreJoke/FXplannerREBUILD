        </mxCell>

        <!-- ======== 分区：保护区 ======== -->
        <mxCell id="z_prot" value="保护区 · app/(protected)/（守卫: proxy.ts + layout.tsx · 未登录 → 302 /login?redirect=原路径）　第一行 = 已实现　第二行 = 规划中" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fontSize=13;fontStyle=1;fillColor=#F7FAFF;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1">
