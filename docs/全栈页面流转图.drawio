        </mxCell>
        <mxCell id="p_home" value="&lt;b&gt;/home 工作台首页&lt;/b&gt;&lt;br&gt;组件: home-dashboard · home-empty-state&lt;br&gt;hook: use-home-state&lt;br&gt;API: GET /api/home/state&lt;br&gt;GET /api/onboarding/status · /api/currencies&lt;br&gt;未完成首次设置 → 向导拦截" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#4A78B5;fontSize=11;align=left;spacing=8;arcSize=8;" vertex="1" parent="z_prot">
