          <mxGeometry x="790" y="60" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_pub" value="守卫 · proxy.ts：已登录访问 / · /login · /register → 302 /home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#C9A227;dashed=1;fontSize=10;align=left;spacing=6;arcSize=8;" vertex="1" parent="z_public">
