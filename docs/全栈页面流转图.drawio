<mxfile host="app.diagrams.net" agent="pi" version="24.7.7" type="device">
  <diagram id="fxplanner-fullstack-flow" name="全栈页面流转图">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;FXPlanner 全栈页面流转图&lt;/b&gt;　—　页面 · 接口 · 模块 · 数据（全量业务：实色 = 已实现，灰虚 = 规划中）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1400" height="34" as="geometry" />
        </mxCell>

        <!-- ======== 分区：公开区 ======== -->
        <mxCell id="z_public" value="公开区 · clients/chat-web/app/（无需登录，proxy.ts 放行）" style="swimlane;html=1;horizontal=1;startSize=36;rounded=0;fontSize=13;fontStyle=1;fillColor=#FFFDF5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1">
