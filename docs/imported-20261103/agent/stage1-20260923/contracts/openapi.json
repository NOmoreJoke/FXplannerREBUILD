{
  "openapi": "3.1.0",
  "info": {
    "title": "FXplanner phase A report agent — design only",
    "version": "stage-a.v1",
    "description": "仅接口设计，尚无部署。使用服务器身份与授权资源，禁止客户端账本事实。"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/planning-agent/generate": {
      "post": {
        "operationId": "generatePhaseAReport",
        "summary": "从已保存计划/预览生成规划或进度报告",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            },
            "description": "同用户同键同内容复用；不能包含个人信息"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./stage-a.schema.json#/$defs/PhaseAGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "生成结果或已保存报告；持久化成功才为generated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "generated"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求格式错误",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "资源不存在或无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "资源版本或幂等冲突",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "阶段不匹配或事实冲突",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "平台限流",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "依赖、保存或进行中任务需重试",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "retryable_error"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "建议等待秒数；不新发并行副本",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/planning-agent/reports/{report_id}": {
      "get": {
        "operationId": "getPhaseAReport",
