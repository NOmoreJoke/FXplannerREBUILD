                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "资源不存在或无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "平台限流",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "rejected"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "依赖、保存或进行中任务需重试",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./stage-a.schema.json#/$defs/PhaseAResponse"
                    },
                    {
                      "properties": {
                        "result": {
                          "properties": {
                            "delivery_status": {
                              "const": "retryable_error"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "建议等待秒数；不新发并行副本",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "x-chatbot-enabled": false,
  "x-future-question-request-schema": "./stage-a.schema.json#/$defs/FutureQuestionRequest",
  "x-future-question-output-schema": "./stage-a.schema.json#/$defs/FutureQuestionOutput"
}
