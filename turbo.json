{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "API_PORT",
        "WEB_PORT",
        "CORS_ORIGIN",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "API_PORT",
        "WEB_PORT",
        "CORS_ORIGIN",
        "NEXT_PUBLIC_API_BASE_URL",
        "DEV_LOG_PORT",
        "NEXT_PUBLIC_DEV_LOG_URL",
        "AUTH_THROTTLE_LIMIT",
        "AUTH_OTP_THROTTLE_LIMIT",
        "THROTTLE_GLOBAL_LIMIT",
        "OTP_EMAIL_MOCK",
        "AI_PROVIDER_AIGYSD_API_KEY",
        "AI_PROVIDER_AIGYSD_ANTHROPIC_API_KEY",
        "AI_PROVIDER_AIGYSD_GEMINI_API_KEY",
        "AI_PROVIDER_AIGYSD_BASE_URL",
        "AI_DEFAULT_CHAT_MODEL",
        "AI_CHAT_ENABLED",
        "AI_CHAT_HISTORY_WINDOW",
        "AI_CHAT_MAX_CONCURRENCY",
        "AI_DAILY_MESSAGE_QUOTA",
        "AI_E2E_FAKE_STREAM",
        "AI_E2E_FAKE_INTERVAL_MS"
      ]
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "API_PORT",
        "WEB_PORT",
        "CORS_ORIGIN",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
