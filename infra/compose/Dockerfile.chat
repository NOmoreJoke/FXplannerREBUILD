# Chat 服务镜像（Nest）。构建上下文为仓库根（context: ../..），
# 以便容器内 Bun 能按 workspace 解析 packages/money 等共享包。
FROM oven/bun:1.2.15-alpine AS base
WORKDIR /app
# monorepo：必须把根配置 + 所有 workspace 成员的 package.json 一起复制，
# 否则 Bun 发现 workspace 结构与 bun.lock 不符，--frozen-lockfile 会报错。
COPY package.json bun.lock bunfig.toml ./
# 全部 workspace 成员与 bun.lock 一致（含 dev-log-server/eslint-config/
# typescript-config），缺任一都会让 --frozen-lockfile 报 lockfile changed。
COPY packages/money/package.json ./packages/money/
COPY packages/dev-log-server/package.json ./packages/dev-log-server/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY services/chat/package.json ./services/chat/
# postinstall（prisma generate）在安装期即执行，schema 必须先于 install 就位
COPY services/chat/prisma ./services/chat/prisma/
COPY clients/chat-web/package.json ./clients/chat-web/
RUN bun install --frozen-lockfile
COPY . .
# @prisma/client 需显式生成：bun install 的 postinstall 在 monorepo 下
# 会被静默跳过，空壳 client 会让 nest build(tsc) 全量报 implicit any。
RUN cd services/chat && bunx prisma generate
# 只构建本服务自己的包。不加 --filter 会触发 turbo 构建全部包(含 chat-web)，
# 而 chat 镜像没有前端所需的 NEXT_PUBLIC_API_BASE_URL，会导致前端 fail-fast 报错。
RUN bun run build --filter=@fxplanner-new/chat

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=base --chown=bun:bun /app/services/chat/dist ./dist
COPY --from=base --chown=bun:bun /app/node_modules ./node_modules
# bun 会将依赖提升至根 node_modules，services/chat 下不产生包内 node_modules
ARG API_PORT=4001
ENV API_PORT=${API_PORT}
EXPOSE ${API_PORT}
USER bun
CMD ["bun", "run", "dist/main.js"]
