# Chat Web 镜像（Next standalone）。对齐 LingJi：构建用 node
# （Bun 的 worker_threads 尚不完整），运行时只带 standalone 产物。
FROM oven/bun:1.2.15-alpine AS deps
WORKDIR /app
# monorepo：根配置 + 全部 workspace 成员的 package.json 必须与 bun.lock
# 一致（缺任一 --frozen-lockfile 即报 lockfile changed）
COPY package.json bun.lock bunfig.toml ./
COPY packages/money/package.json ./packages/money/
COPY packages/dev-log-server/package.json ./packages/dev-log-server/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY services/chat/package.json ./services/chat/
COPY clients/chat-web/package.json ./clients/chat-web/
RUN bun install --frozen-lockfile

FROM deps AS source
COPY . .

# Next 16 的 worker_threads 依赖 Bun 未完全实现，构建必须用 node
FROM node:22-alpine AS web-build
WORKDIR /app
# 12-Factor：构建期变量必须显式注入，不在 Dockerfile 里硬编码。
# docker build --build-arg NEXT_PUBLIC_API_BASE_URL=https://api.example.com .
ARG NEXT_PUBLIC_API_BASE_URL
RUN test -n "$NEXT_PUBLIC_API_BASE_URL" || \
  (echo "ERROR: NEXT_PUBLIC_API_BASE_URL build arg is required" && exit 1)
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
COPY --from=source /app ./
WORKDIR /app/clients/chat-web
RUN ../../node_modules/.bin/next build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=web-build /app/clients/chat-web/.next/standalone ./
COPY --from=web-build /app/clients/chat-web/.next/static ./clients/chat-web/.next/static
COPY --from=web-build /app/clients/chat-web/public ./clients/chat-web/public
USER node
EXPOSE 3000
CMD ["node", "clients/chat-web/server.js"]
